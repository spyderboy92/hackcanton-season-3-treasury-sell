NEXT_PUBLIC_LEDGER=canton
LEDGER_NETWORK=sandbox
LEDGER_JSON_API=http://127.0.0.1:6864
LEDGER_USER_ID=treasury-rfq-ui

# HMAC key for the login session cookie (32+ random chars, e.g. `openssl rand -base64 48`).
# Unset: a random per-process secret is used and every restart signs users out.
# SESSION_SECRET=<paste a long random value; do not reuse this placeholder>
# Optional: pin the operator party (signatory of the account directory and party profiles).
# LEDGER_PARTY_OPERATOR=treasuryos-Operator::REPLACE_FINGERPRINT

# Optional: link settled trades' ledger transaction ids to an HTTPS explorer
# (<url>/transactions/<update id>). Unset here, the id is shown without a link.
# LEDGER_EXPLORER_URL=https://lighthouse.devnet.cantonloop.com
