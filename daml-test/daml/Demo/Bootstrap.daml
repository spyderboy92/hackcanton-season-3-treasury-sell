-- | Sandbox seeding script -- NOT part of the test suite.
--
-- Seeds a live Canton sandbox with the spec section 4 scenario so the frontend has real
-- data to render, and STOPS before any quote is submitted: the point of the demo is to
-- drive the quoting, the accept and the settlement from the UI and watch each party's
-- view of the ledger differ.
--
-- What it creates:
--   * six parties -- Treasury, DealerA, DealerB, DealerC, Auditor, Registry -- allocated
--     with prefixed id hints so the party ids read as @treasuryos-DealerB::1220...@
--   * holdings issued by Registry: Treasury 25 cETH, each dealer 1,000,000 USD
--   * one Open RFQ: Treasury SELLS 10 cETH quoted in USD, inviting all three dealers
--   * one RfqInvitation per dealer, each observed by that dealer alone
--   * an Operator party (id hint @treasuryos-Operator@): the app operator the Next.js
--     server acts as to read the directory and verify logins (HAC-12/13)
--   * one empty AccountDirectory, signed by Operator
--   * one PartyProfile per seat -- treasury, dealerA, dealerB, dealerC, auditor,
--     registry -- carrying the label and institution the UI shows, each observed by the
--     party it describes
--   * five UserAccounts registered through AccountDirectory.Register: treasury,
--     dealer-a, dealer-b, dealer-c, auditor, each with password == username (public
--     demo credentials; see 'Tests.Fixtures.demoAccounts' for how the hashes are made)
--
-- What it deliberately does NOT create: any Quote, AcceptedTrade, SettlementInstruction
-- or SettlementReceipt.
--
-- Run it with:
--
-- > dpm build --all
-- > dpm script --dar daml-test/.daml/dist/treasury-rfq-tests-0.0.1.dar \
-- >   --script-name Demo.Bootstrap:bootstrap \
-- >   --ledger-host 127.0.0.1 --ledger-port 6865 --upload-dar true -w
--
-- The party ids (including the operator's) and the demo usernames are printed at the
-- end, one per line, ready to paste into the frontend config.
--
-- The per-script test runner discovers 'bootstrap' too, so @dpm test@ runs it end to end
-- against the IDE ledger on every run: a seed that no longer type-checks or whose
-- registrations violate an 'ensure' fails the suite rather than a live demo.
module Demo.Bootstrap where

import DA.Foldable (forA_)
import Daml.Script

import Tests.Fixtures

-- | What the seed produced: the open auction and the operator-side directory.
data Bootstrapped = Bootstrapped with
    rfq : OpenRfq
    accounts : SeededAccounts
  deriving (Eq, Show)

-- | Seed the ledger and print the party ids.
bootstrap : Script Bootstrapped
bootstrap = do
  fx <- openRfq
  let p = fx.parties
  seeded <- seedAccounts p

  debug "=================================================================="
  debug "Treasury RFQ demo seeded. Party ids for the frontend config:"
  forA_
    [ ("treasury", p.treasury)
    , ("dealerA", p.dealerA)
    , ("dealerB", p.dealerB)
    , ("dealerC", p.dealerC)
    , ("auditor", p.auditor)
    , ("registry", p.registry)
    , ("operator", seeded.operator)
    ]
    (\(label, party) -> debug (label <> ": " <> show party))
  debug "------------------------------------------------------------------"
  debug ("rfqId: " <> fx.rfqId)
  debug ("asset: " <> demoAsset <> "  currency: " <> demoCurrency)
  debug ("side: Sell  quantity: " <> show demoQuantity)
  debug ("quoteDeadline: " <> show fx.quoteDeadline)
  debug "Three invitations are outstanding; no quote has been submitted."
  debug "------------------------------------------------------------------"
  debug "Demo logins (password == username), registered under the operator:"
  forA_ demoAccounts $ \a ->
    debug ("  " <> a.username <> "  (" <> show a.userType <> ", seat " <> a.seat <> ")")
  debug "=================================================================="

  pure Bootstrapped with rfq = fx; accounts = seeded
