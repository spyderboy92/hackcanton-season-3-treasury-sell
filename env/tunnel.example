# Cloudflare Tunnel profile — public UI, private ledger.
#
# 1. Dashboard → Networking → Tunnels → Create.
# 2. Published application route:
#      Hostname:  rfq-app.z12z.org
#      Service:   http://frontend:3000      (compose DNS name — NOT localhost,
#                                           and NEVER canton:6864 / :6865)
# 3. Copy the tunnel token (eyJ…) into TUNNEL_TOKEN below.
# 4. From the repo root:
#
#      set -a && source env/tunnel.local && set +a
#      docker compose --profile tunnel up
#
# Copy this file to env/tunnel.local (gitignored) and fill in TUNNEL_TOKEN /
# SESSION_SECRET. Do not commit those secrets.

TUNNEL_TOKEN=REPLACE_WITH_CLOUDFLARE_TUNNEL_TOKEN

# Public HTTPS origin of the published hostname (no trailing slash).
APP_ORIGIN=https://rfq-app.z12z.org

# Keep sessions across container restarts (32+ random chars).
# SESSION_SECRET=$(openssl rand -base64 48)
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_VALUE
