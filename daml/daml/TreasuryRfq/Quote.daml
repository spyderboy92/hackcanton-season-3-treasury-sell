module TreasuryRfq.Quote where

import TreasuryRfq.Rfq (RFQ)
import TreasuryRfq.Types

-- Both parties sign so a dealer cannot mint a Quote without treasury authority from an invitation.
template Quote
  with
    treasury : Party
    dealer : Party
    rfqCid : ContractId RFQ
    asset : Text
    quoteCurrency : Text
    side : Side
    quantity : Decimal
    price : Decimal
    expiry : Optional Time
  where
    signatory treasury, dealer

    ensure
      quantity > 0.0
        && price > 0.0
        && asset /= ""
        && quoteCurrency /= ""
        && treasury /= dealer
