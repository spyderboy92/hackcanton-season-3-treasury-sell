module TreasuryRfq.Trade where

import TreasuryRfq.Rfq (RFQ)

-- Binding bilateral terms after accept. Losing dealers are not stakeholders.
template AcceptedTrade
  with
    treasury : Party
    dealer : Party
    rfqCid : ContractId RFQ
    asset : Text
    quoteCurrency : Text
    quantity : Decimal
    price : Decimal
    acceptedAt : Time
  where
    signatory treasury, dealer

    ensure
      quantity > 0.0
        && price > 0.0
        && asset /= ""
        && quoteCurrency /= ""
        && treasury /= dealer
